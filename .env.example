# 复制成 .env 并填入真实值（.env 已被 .gitignore 排除，不会入库）
#
# TikTok Shop 开放平台 —— partner.tiktokshop.com，卖家授权后可用
# 能拿到：商品、订单、GMV、挂车视频表现、店铺经营数据
TTS_APP_KEY=
TTS_APP_SECRET=
TTS_SERVICE_ID=
TTS_SHOP_ID=
TTS_SHOP_NAME=
TTS_SHOP_REGION=TH
TTS_SHOP_TYPE=LOCAL
# 卖家授权后拿到的访问令牌（形如 ROW_xxx）
TTS_ACCESS_TOKEN=
# 用 access_token 调 /seller/202309/shops 换取
TTS_SHOP_CIPHER=

# Marketing API —— ads.tiktok.com，GMV Max，与上面完全独立的一套
# 能拿到：广告消耗、ROAS、GMV Max 相关投放数据
TTM_APP_ID=
TTM_APP_SECRET=
TTM_ADVERTISER_ID=
TTM_BC_ID=
