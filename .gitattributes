# 统一换行符：仓库里一律 LF。
# 原因：scripts/*.sh 与 .github/workflows/*.yml 里的 run: 块会在 Linux / macOS
# 的 CI 机器上执行，一旦被 checkout 成 CRLF，bash 会报 `\r: command not found`。
* text=auto eol=lf

*.sh   text eol=lf
*.bash text eol=lf
*.py   text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf

# Windows 专有脚本保留 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 二进制，别做任何转换
*.png  binary
*.ico  binary
*.woff2 binary
*.exe  binary
*.zip  binary
*.tar.gz binary
