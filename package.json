{
  "name": "tiktok-scraper",
  "version": "2.2.0",
  "private": true,
  "description": "TikTok 多账号数据抓取与分析工作台（统一应用：抓取 · 周期对比 · 挂车分析 · 导出）",
  "author": "TikTok Scraper",
  "main": "electron/main.js",
  "bin": {
    "tiktok-scraper": "bin/cli.js"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "app": "electron .",
    "build:payload": "node scripts/build-payload.js",
    "build:app": "node scripts/build-payload.js && electron-builder --win --publish never",
    "build:app:mac": "bash scripts/build-mac.sh",
    "release": "node scripts/build-payload.js && electron-builder --win --publish always",
    "test": "node --test test/*.test.js",
    "setup": "node bin/cli.js setup",
    "mcp": "node mcp/server.js",
    "cli": "node bin/cli.js",
    "agents": "node scripts/setup-agents.js"
  },
  "build": {
    "appId": "com.ttscraper.app",
    "productName": "TikTokScraper",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!browser-payload*.tar.gz",
      "!browser-payload*.tar.gz.bak",
      "!*.bak",
      "!**/.env",
      "!**/.env.*",
      "!runtime.json",
      "!settings.json",
      "!_*.txt",
      "!_*.png",
      "!_*.js",
      "!scripts/_*.js",
      "!.*-browsers/**",
      "!.mac-browsers*/**",
      "!.win-browsers*/**",
      "!_macdl/**",
      "!dist/**",
      "!release/**",
      "!release-mac/**",
      "!out/**",
      "!data/**",
      "!browsers/**",
      "!docs/**",
      "!scripts/**",
      "!vendor/**",
      "!*.md",
      "!nul",
      "!test/**",
      "!mcp/**",
      "!bin/**",
      "!skills/**",
      "!.claude-plugin/**",
      "!.codex-plugin/**",
      "!.agents/**",
      "!.mcp.json"
    ],
    "extraResources": [
      {
        "from": "browser-payload.tar.gz",
        "to": "browser-payload.tar.gz"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "TikTokScraper-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "TikTokScraper-${version}-setup.exe"
    },
    "compression": "normal",
    "mac": {
      "target": [
        {
          "target": "zip"
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "TikTokScraper-${version}-${arch}-mac.zip"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "liyangru",
        "repo": "tiktok-scraper",
        "releaseType": "release"
      }
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^5.2.0",
    "patchright": "^1.63.0",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.64.0"
  },
  "license": "MIT"
}
